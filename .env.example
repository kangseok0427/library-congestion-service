# Local default. Production should use an absolute persistent path.
# PythonAnywhere example: /home/YOURUSERNAME/library-congestion-data/records.json
# Railway example: /data/records.json
LIBRARY_RECORDS=data/processed/records.json

# Use only to seed empty persistent storage. Existing data is never overwritten.
LIBRARY_BOOTSTRAP_SAMPLE=true

# Used by container platforms and local scripts. PythonAnywhere uses a Unix socket.
PORT=8000
