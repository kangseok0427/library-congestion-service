# Local default. Production should use an absolute persistent path.
# PythonAnywhere example: /home/YOURUSERNAME/library-congestion-data/records.json
# Railway example: /data/records.json
LIBRARY_RECORDS=data/processed/records.json

# Use only to seed empty persistent storage. Existing data is never overwritten.
LIBRARY_BOOTSTRAP_SAMPLE=true

# Administrator session credentials. Use unique production values and a long random secret.
ADMIN_USERNAME=replace-me
ADMIN_PASSWORD=replace-me
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Used by container platforms and local scripts. PythonAnywhere uses a Unix socket.
PORT=8000

# Vercel cloud entrypoint app.py (server-side only).
DATABASE_URL=postgresql://library_backend:replace-me@YOUR_ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
NEON_AUTH_URL=https://YOUR_AUTH_ENDPOINT/neondb/auth
APP_ORIGIN=https://YOUR_SITE.vercel.app
NEON_STORAGE_ENDPOINT=https://YOUR_STORAGE_ENDPOINT
NEON_STORAGE_REGION=us-east-2
NEON_STORAGE_ACCESS_KEY_ID=replace-with-scoped-storage-access-key
NEON_STORAGE_SECRET_ACCESS_KEY=replace-with-scoped-storage-secret
NEON_STORAGE_BUCKET=library-data
NEON_UPLOAD_BUCKET=library-uploads
